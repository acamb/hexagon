bin/
*.db
*.db-shm
*.db-wal
.env
/.idea/hexagon.iml
/config.json

# Certificates for the reference proxy: never in the repository. The directory
# itself is kept, because compose mounts it and Docker would otherwise create it
# as root.
deploy/proxy/certs/*
!deploy/proxy/certs/.gitkeep

# Release artifacts. Anchored, so it cannot swallow web/dist as well.
/dist/
